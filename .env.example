# MyBizGate Client API — environment template
#
# One template for every environment. Section A holds the only values that
# differ between local development and production; section B is the same
# everywhere. Production's copy lives at /home/mybizgat/app/client-api/.env,
# is server-managed and is never uploaded by the deploy workflow.
#
# Local:      cp .env.example .env && php artisan key:generate && php artisan migrate
# Production: copy this file, apply the "production:" values in section A,
#             generate APP_KEY once (php artisan key:generate --show) and never
#             change it afterwards. Migrations are applied by hand (phpMyAdmin);
#             the deploy never runs php artisan migrate.
#
# Tests ignore this file: phpunit.xml forces sqlite :memory: and array drivers.

# ---------------------------------------------------------------------------
# A. Environment-specific
# ---------------------------------------------------------------------------
APP_NAME="MyBizGate Client API"

# production: APP_ENV=production   (the deploy health check asserts this)
APP_ENV=local

# production: APP_DEBUG=false      (debug pages would expose paths, config and SQL)
APP_DEBUG=true

# production: APP_URL=https://client-api.mybizgate.com
APP_URL=http://localhost:8000

# Generated per environment; the production key must never be regenerated.
APP_KEY=

# MySQL/MariaDB in every environment (sqlite is used by tests only).
# Local: the workspace MariaDB, same credentials as ../media-api used to carry.
# production: the cPanel MySQL database and user created for client-api, e.g.
#   DB_DATABASE=mybizgat_platform  DB_USERNAME=mybizgat_clientapi  (host stays 127.0.0.1)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mybizgat_platform
DB_USERNAME=mybizgate_dev
DB_PASSWORD=

# Root of the tenant_uploads disk (prototype /test/* routes only; real media is in media-api).
# Keep it outside the application and outside public_html.
# production: TENANT_UPLOAD_PATH=/home/mybizgat/data/client-api/uploads
TENANT_UPLOAD_PATH=/home/jul/Workspace/mybizgate/uploads/client-api

# media-api base URL used by App\Services\MediaApiClient.
# production: MEDIA_API_URL=https://media-api.mybizgate.com/api/v1
MEDIA_API_URL=http://127.0.0.1:8001/api/v1

# production: LOG_LEVEL=warning
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# B. Same in every environment
# ---------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null

# File-based drivers: no cache/session/jobs tables are needed at runtime and
# nothing on shared hosting runs a queue worker.
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

VITE_APP_NAME="${APP_NAME}"
